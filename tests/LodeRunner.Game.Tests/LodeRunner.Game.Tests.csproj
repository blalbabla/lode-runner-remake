<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- FpsController and FpsCamera have no Raylib types so they can be compiled stand-alone. -->
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LodeRunner.Core\LodeRunner.Core.csproj" />
  </ItemGroup>

  <!-- Compile only the pure-logic Game files (no Raylib window APIs). -->
  <ItemGroup>
    <Compile Include="..\..\src\LodeRunner.Game\Input\FpsController.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\SpatialAudio.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\Sfx.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\ProceduralMixer.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\DarkAmbientSynth.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\AudioDiag.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\ProceduralSfx.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\ProceduralSfx.Extra.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\ProceduralStone.cs" />
    <Compile Include="..\..\src\LodeRunner.Game\Audio\ProceduralFootsteps.cs" />
  </ItemGroup>

</Project>
