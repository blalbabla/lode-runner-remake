<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LodeRunner.Core\LodeRunner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\levels\*.txt" Link="assets\levels\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\fonts\*.*" Link="assets\fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\icon\*.*" Link="assets\icon\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\assets\icon\lode-runner.ico</ApplicationIcon>
    <AssemblyName>LodeRunner</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyTitle>Lode Runner</AssemblyTitle>
    <Company>Vibecoding</Company>
    <Product>Lode Runner 3D</Product>

  </PropertyGroup>

</Project>
